# Example server environment variables (DO NOT COMMIT your real .env)
# Copy this file to `server/.env` and fill in the real values.

# JWT secret
JWT_SECRET=your_jwt_secret_here

# MongoDB connection
MONGO_URL=mongodb://localhost:27017/learnsphere

# Cloudinary
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# Google Drive service account JSON path
GOOGLE_DRIVE_CLIENT_EMAIL=your_service_account_email
GOOGLE_DRIVE_PRIVATE_KEY=your_private_key

# Payment provider keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Other secrets
# ...
